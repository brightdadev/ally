# ==============================================================================
# Ally Environment Configuration Template (.env.example)
# Author: Bright da dev
#
# IMPORTANT NOTICE:
# This file is ONLY AN EXAMPLE showing the required format for your local '.env'.
# Do NOT place your real API keys in this file, as this template is tracked by Git.
#
# SETUP INSTRUCTIONS:
# 1. Create a copy of this file named '.env':
#    powershell: Copy-Item .env.example .env
# 2. Replace the placeholder below in your new '.env' with your actual API key.
# 3. Obtain a Gemini API key at: https://aistudio.google.com/
# ==============================================================================

GEMINI_API_KEY=your_gemini_api_key_here